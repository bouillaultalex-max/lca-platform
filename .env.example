# Variables pour le déploiement via docker-compose (copier en ".env" à la racine).
# Ne concerne PAS le développement local sans Docker : voir apps/api/.env.example.

POSTGRES_USER=lca_mes
POSTGRES_PASSWORD=changez-moi-en-production
POSTGRES_DB=lca_mes

# Générer une valeur forte et unique (ex: openssl rand -hex 32), différente de tout
# secret utilisé en développement.
JWT_SECRET=a-remplacer-par-une-valeur-forte-et-secrete
JWT_EXPIRES_IN_SECONDS=28800
