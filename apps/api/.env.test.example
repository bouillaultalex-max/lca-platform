# Copier en ".env.test" — base dédiée aux tests e2e, distincte de la base de développement.
# Créer au préalable (exemple) :
#   CREATE DATABASE lca_mes_test OWNER lca_mes;
DATABASE_URL="postgresql://lca_mes:changez-moi@localhost:5432/lca_mes_test?schema=public"

JWT_SECRET="test-secret-uniquement-pour-les-tests-automatises"
JWT_EXPIRES_IN_SECONDS=28800

PORT=3001
NODE_ENV=test
