// Schéma Prisma — LCA-MES
// Source unique de vérité du modèle de données (voir docs/modele-donnees.md à la racine du dépôt).
// Toute évolution passe par une migration versionnée : `npm run prisma:migrate`.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // Le tsconfig Nest 11 utilise "module": "nodenext", que Prisma ne reconnaît pas
  // automatiquement comme CommonJS : sans ce réglage explicite, le client généré
  // utilise `import.meta.url` et casse au chargement (require) par Nest.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Rôles utilisateurs (voir docs/regles-metier.md §1).
/// RESPONSABLE_LABORATOIRE et RESPONSABLE_ADJOINT ont un accès complet.
/// DIRECTION et DAF sont strictement en lecture seule.
enum UserRole {
  RESPONSABLE_LABORATOIRE
  RESPONSABLE_ADJOINT
  DIRECTION
  DAF

  @@map("user_role")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

/// Type d'un retour utilisateur (voir Feedback, collecte des premiers tests V0.3).
enum FeedbackType {
  BUG
  IDEE
  AMELIORATION
  QUESTION

  @@map("feedback_type")
}

/// Priorité déclarée par l'utilisateur, pour trier rapidement les retours pendant
/// les premiers tests — pas de calcul automatique, une saisie simple.
enum FeedbackPriority {
  NORMALE
  IMPORTANTE
  BLOQUANTE

  @@map("feedback_priority")
}

/// Volontairement limité à 2 statuts : pas de workflow, juste "à regarder" / "vu".
enum FeedbackStatus {
  NOUVEAU
  TRAITE

  @@map("feedback_status")
}

/// Type d'article (voir docs/modele-donnees.md §1) : une table unique pour matières
/// premières, packaging et produits finis, distingués par ce type.
enum ArticleType {
  MATIERE_PREMIERE
  PACKAGING
  PRODUIT_FINI

  @@map("article_type")
}

/// Statut d'une recette (voir docs/modele-donnees.md §2).
enum RecipeStatus {
  ACTIVE
  ARCHIVEE

  @@map("recipe_status")
}

/// Type de mouvement de stock (voir docs/regles-metier.md §3).
enum StockMovementType {
  ENTREE
  SORTIE_BATCH
  AJUSTEMENT_INVENTAIRE
  EXPORT_OPENSI

  @@map("stock_movement_type")
}

/// Statut d'un batch de production (voir docs/modele-donnees.md §4).
enum BatchStatus {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE

  @@map("batch_status")
}

/// Étape du workflow réel de production (voir docs/regles-metier.md §12), distincte
/// du statut global (`BatchStatus`) : le statut indique l'état global du batch, l'étape
/// indique où on en est dans le déroulement de la production. Pour la V0.9, seule
/// l'étape courante est stockée sur `Batch.currentStep` — les horodatages détaillés
/// par étape pourront être ajoutés plus tard si nécessaire, pas anticipés maintenant.
enum BatchStep {
  PREPARATION
  MELANGE
  INCORPORATION_TREMIE
  CONDITIONNEMENT

  @@map("batch_step")
}

/// Statut qualité global du lot, calculé automatiquement à partir de l'ensemble
/// de ses `QualityCheck` (voir docs/regles-metier.md §6). La règle de calcul exacte
/// et le module `quality` lui-même sont prévus au Jalon 3 ; le champ existe déjà ici
/// car il fait partie intégrante de l'entité Lot (valeur par défaut EN_ATTENTE en
/// l'absence de tout contrôle qualité pour l'instant).
enum LotQualityStatus {
  EN_ATTENTE
  CONFORME
  NON_CONFORME
  BLOQUE

  @@map("lot_quality_status")
}

/// Type de fichier importé depuis OpenSi (voir docs/regles-metier.md §7).
enum ImportType {
  ARTICLES
  STOCKS
  BESOINS_ATTENDUS
  INVENTAIRE

  @@map("import_type")
}

enum ImportStatus {
  PREVISUALISE
  VALIDE
  ERREUR

  @@map("import_status")
}

/// Type de fichier exporté vers OpenSi (voir docs/regles-metier.md §9).
enum ExportType {
  PRODUCTIONS
  CONSOMMATIONS
  MOUVEMENTS_STOCK
  INVENTAIRES
  RAPPORTS

  @@map("export_type")
}

/// Site de production. Un seul enregistrement existe en V0.9 ;
/// cette table prépare l'évolution multi-site sans fonctionnalité multi-site en V0.9.
model Site {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]
  jobTitles            JobTitle[]
  articles             Article[]
  machines             Machine[]
  suppliers            Supplier[]
  markets              Market[]
  productFamilies      ProductFamily[]
  recipes              Recipe[]
  recipeDrafts         RecipeDraft[]
  stockLots            StockLot[]
  stockItems           StockItem[]
  stockMovements       StockMovement[]
  batches              Batch[]
  lots                 Lot[]
  importLogs           ImportLog[]
  exportLogs           ExportLog[]
  expectedRequirements ExpectedRequirement[]
  columnMappingRules   ColumnMappingRule[]
  feedbackEntries      Feedback[]
  aiConversations      AiConversation[]

  @@map("sites")
}

/// Fonction métier d'un utilisateur (voir docs/adr — Jalon 2.5), distincte de son
/// rôle logiciel (`UserRole`, qui pilote les permissions). Table dédiée plutôt qu'un
/// texte libre pour éviter les doublons ("Responsable labo" / "Resp labo"...) et
/// permettre une réutilisation future (tableau de bord, statistiques par fonction...).
/// `siteId` déjà présent : une même fonction pourra différer d'un site à l'autre plus tard.
model JobTitle {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@unique([siteId, name])
  @@map("job_titles")
}

model User {
  id                 String    @id @default(uuid())
  siteId             String    @map("site_id")
  site               Site      @relation(fields: [siteId], references: [id])
  fullName           String    @map("full_name")
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  /// Fonction métier (voir `JobTitle`) — nullable en base pour ne jamais casser un
  /// compte existant, mais obligatoire côté validation à la création d'un nouvel
  /// utilisateur via l'écran Administration.
  jobTitleId         String?   @map("job_title_id")
  jobTitle           JobTitle? @relation(fields: [jobTitleId], references: [id])
  /// Capacité d'administration des comptes, volontairement indépendante du rôle
  /// logiciel (`role`) : un utilisateur garde ses permissions métier normales et
  /// reçoit en plus, ou non, le droit de gérer les utilisateurs.
  isSystemAdmin      Boolean   @default(false) @map("is_system_admin")
  /// Force le changement de mot de passe avant tout accès (première connexion
  /// après création, ou après une réinitialisation par un administrateur).
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  auditLogs       AuditLog[]
  loginHistory    LoginHistory[]
  stockMovements  StockMovement[]
  batchesCreated  Batch[]
  importLogs      ImportLog[]
  exportLogs      ExportLog[]
  feedbackEntries Feedback[]
  recipeDrafts    RecipeDraft[]
  aiConversations AiConversation[]

  @@map("users")
}

/// Journal technique des écritures sensibles (qui, quoi, quand).
/// Distinct de la généalogie de traçabilité métier des lots, qui sera introduite
/// avec le module `traceability` lors du développement métier.
model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String      @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Historique des tentatives de connexion (réussies ou non), séparé de `AuditLog`
/// qui reste réservé aux actions métier — voir décision Jalon 2.5. Permet de détecter
/// plus tard des comportements anormaux (tentatives répétées, IP inhabituelle...).
/// `userId` nullable : une tentative sur un email inconnu ne peut être rattachée à
/// personne, mais reste enregistrée (avec l'email tel que saisi) pour la surveillance.
model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  succeeded Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([email])
  @@map("login_history")
}

/// Retour utilisateur (bug/idée/amélioration/question) collecté pendant les premiers
/// tests réels (V0.3) — journal simple, append-only : pas de commentaires, pas
/// d'assignation, pas de notifications. `appVersion` fige le contexte applicatif au
/// moment du signalement, pour être compréhensible en le relisant bien plus tard.
model Feedback {
  id         String           @id @default(uuid())
  siteId     String           @map("site_id")
  site       Site             @relation(fields: [siteId], references: [id])
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id])
  type       FeedbackType
  priority   FeedbackPriority @default(NORMALE)
  message    String
  pageUrl    String           @map("page_url")
  appVersion String           @map("app_version")
  status     FeedbackStatus   @default(NOUVEAU)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("feedback")
}

// ---------------------------------------------------------------------------
// Assistant IA (AI-01/AI-02) — infrastructure uniquement : aucun outil métier,
// aucune action, aucune confirmation à ce stade. Voir docs/roadmap.md.
// ---------------------------------------------------------------------------

/// Rôle d'un message dans une conversation avec l'assistant. TOOL_CALL (AI-04) :
/// trace qu'un outil a été appelé (nom uniquement, voir AiMessage.toolName) —
/// aucun rôle équivalent pour le résultat d'un outil : ToolResult reste
/// strictement éphémère (voir ToolCallingOrchestrator), jamais persisté.
enum AiMessageRole {
  USER
  ASSISTANT
  TOOL_CALL

  @@map("ai_message_role")
}

/// Conversation avec l'assistant IA. Persistance minimale (AI-02) : identité et
/// horodatage uniquement — pas encore de résultats d'outils, d'actions proposées
/// ni de confirmations (voir AI-05/AI-06 dans docs/roadmap.md).
model AiConversation {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

/// Message d'une conversation. `content` est le texte brut échangé (vide pour
/// role = TOOL_CALL). `toolName` (AI-04) n'est renseigné que pour role =
/// TOOL_CALL : nom de l'outil appelé, jamais ses paramètres ni son résultat
/// (voir ToolCallingOrchestrator — aucune donnée métier persistée ici).
model AiMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  toolName       String?        @map("tool_name")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Catalogue (voir docs/modele-donnees.md §1-2)
// ---------------------------------------------------------------------------

/// Table unique pour matières premières, packaging et produits finis (distingués par `type`),
/// pour éviter de dupliquer une structure très proche entre trois tables.
model Article {
  id              String         @id @default(uuid())
  siteId          String         @map("site_id")
  site            Site           @relation(fields: [siteId], references: [id])
  type            ArticleType
  openSiReference String         @map("opensi_reference")
  name            String
  unitOfMeasure   String         @map("unit_of_measure")
  currentUnitCost Decimal        @map("current_unit_cost")
  /// Conditionnement en carton, à l'affichage uniquement (le stock reste compté en
  /// unités) — voir docs/roadmap.md "Décisions actées le 2026-07-06". Valeur libre,
  /// modifiable article par article (pas de règle figée en dur) ; par défaut suggéré
  /// à la création : 100 pour les flacons 10/30/50/100 ml, 36 pour les flacons 200 ml.
  unitsPerCarton  Int?           @map("units_per_carton")
  /// Densité (kg par litre), pour les matières premières uniquement — permet de calculer
  /// la masse à peser à partir du volume en préparation de batch (voir docs/regles-metier.md
  /// §12). Optionnelle, saisie manuelle article par article, aucune valeur par défaut :
  /// si absente, le batching affiche le volume et signale "densité manquante" pour la masse.
  densityKgPerL   Decimal?       @map("density_kg_per_l")
  /// Fournisseur principal, matières premières et packaging uniquement — jamais
  /// produit fini (voir SuppliersService/ArticlesService) — un seul fournisseur
  /// par article en V0.9, jamais de prix ni de commandes ici (voir Supplier
  /// ci-dessous). Forcé à null si le type de l'article devient PRODUIT_FINI.
  supplierId      String?        @map("supplier_id")
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  /// Famille commerciale et marché de déclinaison, pertinents uniquement pour un
  /// PRODUIT_FINI (voir ADR 0006 et docs/modele-donnees.md §4bis, PRD-11) — `marketId`
  /// ne peut être renseigné que si `productFamilyId` l'est aussi (règle de service,
  /// pas encore implémentée à ce stade purement additif de la migration).
  productFamilyId String?        @map("product_family_id")
  productFamily   ProductFamily? @relation(fields: [productFamilyId], references: [id])
  marketId        String?        @map("market_id")
  market          Market?        @relation(fields: [marketId], references: [id])
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  recipeLines                   RecipeLine[]
  recipesAsFinishedProduct      Recipe[]
  recipeDraftsAsFinishedProduct RecipeDraft[]
  stockLots                     StockLot[]
  stockItem                     StockItem?
  stockMovements                StockMovement[]
  genealogyLines                LotGenealogy[]
  expectedRequirements          ExpectedRequirement[]
  productAllocations            BatchProductAllocation[]

  @@unique([siteId, openSiReference])
  @@unique([productFamilyId, marketId])
  @@map("articles")
}

/// Fournisseur d'une matière première (V0.3). Volontairement limité à une fiche
/// simple (coordonnées) : ni prix, ni commandes, ni fournisseurs multiples par
/// matière — ces évolutions pourront s'appuyer sur cette table sans la restructurer.
model Supplier {
  id          String   @id @default(uuid())
  siteId      String   @map("site_id")
  site        Site     @relation(fields: [siteId], references: [id])
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  articles Article[]

  @@map("suppliers")
}

model Machine {
  id               String   @id @default(uuid())
  siteId           String   @map("site_id")
  site             Site     @relation(fields: [siteId], references: [id])
  name             String
  supportedFormats Int[]    @map("supported_formats")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  batches Batch[]

  @@map("machines")
}

/// Marché (destination commerciale ou réglementaire, ex. France/Suisse) — voir ADR 0006
/// et docs/modele-donnees.md §4bis (PRD-11). Indépendant du multi-site : LCA-MES reste
/// mono-site, un marché est une propriété optionnelle d'un produit fini, pas un lieu de
/// production. Référentiel simple, dans l'esprit de `Supplier`/`Machine`.
model Market {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id])
  code      String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles    Article[]
  allocations BatchProductAllocation[]

  @@map("markets")
}

/// Famille commerciale : regroupe les déclinaisons d'un même produit par marché (ex.
/// "Recharge Lavande" → déclinaison France, déclinaison Suisse) — voir ADR 0006 et
/// docs/modele-donnees.md §4bis (PRD-11). Concept distinct de la future notion de
/// "gamme" (MASTER_BACKLOG.md, DEBT-05), non fusionnés à ce stade.
model ProductFamily {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles Article[]

  @@map("product_families")
}

/// Une recette utilisée dans un batch conserve sa version au moment de l'utilisation :
/// une modification ultérieure ne doit jamais altérer rétroactivement un batch déjà clôturé
/// (voir docs/regles-metier.md §2).
model Recipe {
  id                String       @id @default(uuid())
  siteId            String       @map("site_id")
  site              Site         @relation(fields: [siteId], references: [id])
  finishedProductId String       @map("finished_product_id")
  finishedProduct   Article      @relation(fields: [finishedProductId], references: [id])
  format            Int
  version           Int
  status            RecipeStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  lines       RecipeLine[]
  batches     Batch[]
  allocations BatchProductAllocation[]

  @@unique([finishedProductId, format, version])
  @@map("recipes")
}

model RecipeLine {
  id              String   @id @default(uuid())
  recipeId        String   @map("recipe_id")
  recipe          Recipe   @relation(fields: [recipeId], references: [id])
  articleId       String   @map("article_id")
  article         Article  @relation(fields: [articleId], references: [id])
  quantityPerUnit Decimal  @map("quantity_per_unit")
  unit            String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([recipeId, articleId])
  @@map("recipe_lines")
}

/// Brouillon de saisie d'une recette (mini-jalon "Brouillons de recettes", 2026-07-13).
/// Table volontairement séparée de `Recipe`/`RecipeLine` : un brouillon n'apparaît jamais
/// dans la liste officielle des recettes et ne subit aucune validation métier (contenu
/// potentiellement partiel/invalide) — seule la création finale via RecipesService.create
/// valide et écrit dans `Recipe`. Un seul brouillon par utilisateur et par produit fini
/// (voir docs/adr/0004-brouillons-recettes.md).
model RecipeDraft {
  id                String  @id @default(uuid())
  siteId            String  @map("site_id")
  site              Site    @relation(fields: [siteId], references: [id])
  userId            String  @map("user_id")
  user              User    @relation(fields: [userId], references: [id])
  finishedProductId String  @map("finished_product_id")
  finishedProduct   Article @relation(fields: [finishedProductId], references: [id])

  /// Contenu libre de la saisie en cours : { format: number | null,
  /// lines: { articleId: string | null; quantityPerUnit: string | null; unit: string | null }[] }
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, finishedProductId])
  @@map("recipe_drafts")
}

// ---------------------------------------------------------------------------
// Stocks (voir docs/modele-donnees.md §3 et docs/regles-metier.md §3)
// ---------------------------------------------------------------------------

/// Représente une réception physique (fût, seau, carton de packaging...) avec sa
/// propre quantité restante. Le suivi par lot de réception (et non seulement par
/// article) est ce qui permet la traçabilité amont (rappel produit lot-à-lot).
/// Règle d'affectation à la consommation : FIFO par défaut (premier reçu, premier
/// consommé) — voir docs/regles-metier.md §3. Une évolution FEFO (basée sur
/// `expiryDate`) est envisageable plus tard mais non implémentée pour l'instant.
model StockLot {
  id                String    @id @default(uuid())
  siteId            String    @map("site_id")
  site              Site      @relation(fields: [siteId], references: [id])
  articleId         String    @map("article_id")
  article           Article   @relation(fields: [articleId], references: [id])
  supplierLotNumber String    @map("supplier_lot_number")
  receivedQuantity  Decimal   @map("received_quantity")
  remainingQuantity Decimal   @map("remaining_quantity")
  receivedAt        DateTime  @map("received_at")
  expiryDate        DateTime? @map("expiry_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  movements      StockMovement[]
  genealogyLines LotGenealogy[]

  @@index([articleId, receivedAt])
  @@map("stock_lots")
}

/// Vue agrégée par article, dérivée de la somme des `StockLot.remainingQuantity`
/// de cet article — évite de recalculer cette somme à chaque affichage.
model StockItem {
  id                String   @id @default(uuid())
  siteId            String   @map("site_id")
  site              Site     @relation(fields: [siteId], references: [id])
  articleId         String   @unique @map("article_id")
  article           Article  @relation(fields: [articleId], references: [id])
  availableQuantity Decimal  @default(0) @map("available_quantity")
  minimumThreshold  Decimal? @map("minimum_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("stock_items")
}

model StockMovement {
  id                       String                  @id @default(uuid())
  siteId                   String                  @map("site_id")
  site                     Site                    @relation(fields: [siteId], references: [id])
  articleId                String                  @map("article_id")
  article                  Article                 @relation(fields: [articleId], references: [id])
  stockLotId               String?                 @map("stock_lot_id")
  stockLot                 StockLot?               @relation(fields: [stockLotId], references: [id])
  type                     StockMovementType
  quantity                 Decimal
  movementDate             DateTime                @default(now()) @map("movement_date")
  batchId                  String?                 @map("batch_id")
  batch                    Batch?                  @relation(fields: [batchId], references: [id])
  /// Renseigné pour une sortie de packaging propre à une allocation (voir ADR 0006 et
  /// docs/modele-donnees.md §3, PRD-11) ; laissé vide pour une sortie de matière
  /// première (mélange commun, non ventilé par allocation).
  batchProductAllocationId String?                 @map("batch_product_allocation_id")
  batchProductAllocation   BatchProductAllocation? @relation(fields: [batchProductAllocationId], references: [id])
  userId                   String                  @map("user_id")
  user                     User                    @relation(fields: [userId], references: [id])
  comment                  String?
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Batching & production (voir docs/modele-donnees.md §4)
// ---------------------------------------------------------------------------

model Batch {
  id                 String      @id @default(uuid())
  siteId             String      @map("site_id")
  site               Site        @relation(fields: [siteId], references: [id])
  recipeId           String      @map("recipe_id")
  recipe             Recipe      @relation(fields: [recipeId], references: [id])
  machineId          String      @map("machine_id")
  machine            Machine     @relation(fields: [machineId], references: [id])
  format             Int
  plannedQuantity    Int         @map("planned_quantity")
  producedQuantity   Int?        @map("produced_quantity")
  rejectedQuantity   Int?        @map("rejected_quantity")
  startedAt          DateTime?   @map("started_at")
  endedAt            DateTime?   @map("ended_at")
  formatChanged      Boolean     @default(false) @map("format_changed")
  formatChangeDetail String?     @map("format_change_detail")
  status             BatchStatus @default(PLANIFIE)
  /// Étape courante du workflow de production (voir BatchStep) ; `null` tant que le
  /// batch n'a pas démarré (statut PLANIFIE).
  currentStep        BatchStep?  @map("current_step")
  createdByUserId    String      @map("created_by_user_id")
  createdByUser      User        @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  stops          BatchStop[]
  stockMovements StockMovement[]
  lots           Lot[]
  allocations    BatchProductAllocation[]

  @@map("batches")
}

model BatchStop {
  id              String    @id @default(uuid())
  batchId         String    @map("batch_id")
  batch           Batch     @relation(fields: [batchId], references: [id])
  reason          String
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMinutes Int?      @map("duration_minutes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("batch_stops")
}

/// Sortie commerciale d'un batch (voir ADR 0006 et docs/modele-donnees.md §4bis,
/// PRD-11) : un batch représente un run physique unique autour d'un seul mélange
/// commun, chaque allocation porte un produit fini, une recette figée (résolue
/// automatiquement, jamais choisie directement par l'utilisateur) et, si le produit
/// appartient à une famille commerciale, un marché. Tout batch possède au moins une
/// allocation, y compris un batch standard sans famille commerciale. Relation 1─1
/// avec `Lot` (voir `Lot.allocationId`). Migration purement additive : aucun service
/// n'écrit encore dans cette table à ce stade.
model BatchProductAllocation {
  id               String   @id @default(uuid())
  batchId          String   @map("batch_id")
  batch            Batch    @relation(fields: [batchId], references: [id])
  productId        String   @map("product_id")
  product          Article  @relation(fields: [productId], references: [id])
  recipeId         String   @map("recipe_id")
  recipe           Recipe   @relation(fields: [recipeId], references: [id])
  marketId         String?  @map("market_id")
  market           Market?  @relation(fields: [marketId], references: [id])
  plannedQuantity  Int      @map("planned_quantity")
  producedQuantity Int?     @map("produced_quantity")
  rejectedQuantity Int?     @map("rejected_quantity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lot            Lot?
  stockMovements StockMovement[]

  @@unique([batchId, productId])
  @@unique([batchId, marketId])
  @@map("batch_product_allocations")
}

// ---------------------------------------------------------------------------
// Lots & traçabilité amont (voir docs/modele-donnees.md §5)
//
// Décision confirmée le 2026-07-05 : LotGenealogy est créée dès le Jalon 2 car
// nécessaire à la déduction précise du stock par StockLot (docs/regles-metier.md §2-3).
// Les écrans de consultation de traçabilité / rappel produit restent au Jalon 3
// (module `traceability`).
// ---------------------------------------------------------------------------

model Lot {
  id             String                  @id @default(uuid())
  siteId         String                  @map("site_id")
  site           Site                    @relation(fields: [siteId], references: [id])
  /// Non unique depuis PRD-11 (voir ADR 0006, docs/modele-donnees.md §5) : un batch
  /// génère désormais un `Lot` par `BatchProductAllocation` — `Batch 1──n Lot`.
  /// Conservé (dénormalisé) pour tout lot, y compris ceux liés à une allocation, pour
  /// ne jamais rompre les lectures existantes qui remontent d'un lot à son batch.
  batchId        String                  @map("batch_id")
  batch          Batch                   @relation(fields: [batchId], references: [id])
  /// Allocation d'origine (voir ADR 0006 et docs/modele-donnees.md §5, PRD-11) —
  /// `null` pour tout lot antérieur à cette feature (`Lot.batch` reste alors l'unique
  /// rattachement, exactement comme avant). Relation 1─1 avec `BatchProductAllocation`.
  allocationId   String?                 @unique @map("allocation_id")
  allocation     BatchProductAllocation? @relation(fields: [allocationId], references: [id])
  /// Généré par LotNumberGeneratorService (TODO : algorithme définitif non fourni,
  /// implémentation actuelle = placeholder isolé derrière une interface simple,
  /// voir docs/regles-metier.md §4).
  lotNumber      String                  @unique @map("lot_number")
  /// Quantité totale produite, rebuts inclus (voir docs/regles-metier.md §3/§5).
  quantity       Int
  manufacturedAt DateTime                @map("manufactured_at")
  expiryDate     DateTime?               @map("expiry_date")
  qualityStatus  LotQualityStatus        @default(EN_ATTENTE) @map("quality_status")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  genealogyLines LotGenealogy[]

  // Remplace l'index unique implicite retiré ci-dessus : conserve la performance des
  // lectures par batchId (ex. TraceabilityService, futur BatchClosureService) sans
  // imposer l'unicité.
  @@index([batchId])
  @@map("lots")
}

/// Table centrale de traçabilité amont : permet de remonter d'un lot fini vers les
/// lots de matières/packaging précis consommés pour le produire (rappel produit
/// lot-à-lot). Générée automatiquement à la clôture du batch à partir de la recette
/// (quantité produite × quantités unitaires), modifiable manuellement en cas d'écart
/// réel constaté. Un lot fini n'est considéré "clôturé" que s'il possède au moins
/// une ligne de généalogie (voir docs/regles-metier.md §2).
model LotGenealogy {
  id                 String   @id @default(uuid())
  lotId              String   @map("lot_id")
  lot                Lot      @relation(fields: [lotId], references: [id])
  consumedArticleId  String   @map("consumed_article_id")
  consumedArticle    Article  @relation(fields: [consumedArticleId], references: [id])
  consumedStockLotId String   @map("consumed_stock_lot_id")
  consumedStockLot   StockLot @relation(fields: [consumedStockLotId], references: [id])
  consumedQuantity   Decimal  @map("consumed_quantity")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("lot_genealogies")
}

// ---------------------------------------------------------------------------
// Imports / exports OpenSi (voir docs/modele-donnees.md §8-9 et docs/regles-metier.md §7-9)
// ---------------------------------------------------------------------------

/// Journal d'un import de fichier OpenSi. Chaque import passe par une prévisualisation
/// obligatoire (dry-run, statut PREVISUALISE) avant toute écriture en base (statut VALIDE) ;
/// journalisé que l'import soit validé ou abandonné.
model ImportLog {
  id             String       @id @default(uuid())
  siteId         String       @map("site_id")
  site           Site         @relation(fields: [siteId], references: [id])
  type           ImportType
  fileName       String       @map("file_name")
  importedAt     DateTime     @default(now()) @map("imported_at")
  status         ImportStatus
  processedLines Int          @map("processed_lines")
  errorCount     Int          @map("error_count")
  /// Détail des erreurs ligne par ligne (ex : [{ "line": 4, "message": "..." }]),
  /// pour que l'historique reste consultable (pas seulement un compteur).
  errorDetails   Json?        @map("error_details")
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("import_logs")
}

/// Journal d'un export de fichier vers OpenSi. Un export n'a pas d'effet de bord :
/// il ne fait que lire et formater les données existantes.
model ExportLog {
  id         String     @id @default(uuid())
  siteId     String     @map("site_id")
  site       Site       @relation(fields: [siteId], references: [id])
  type       ExportType
  fileName   String     @map("file_name")
  exportedAt DateTime   @default(now()) @map("exported_at")
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("export_logs")
}

/// Besoin attendu importé d'OpenSi : quantité à produire pour maintenir le stock de
/// sécurité d'une référence (voir docs/regles-metier.md §8). Le Jalon 2 se limite à
/// importer et stocker cette donnée brute — aucune formule de calcul de suggestion
/// n'est implémentée tant qu'elle n'est pas validée avec l'utilisateur. Le seuil de
/// stock de sécurité lui-même reste porté par `StockItem.minimumThreshold` (source
/// unique, pour éviter la duplication signalée dans docs/modele-donnees.md §12).
model ExpectedRequirement {
  id                  String   @id @default(uuid())
  siteId              String   @map("site_id")
  site                Site     @relation(fields: [siteId], references: [id])
  articleId           String   @map("article_id")
  article             Article  @relation(fields: [articleId], references: [id])
  reservedQuantity    Decimal? @map("reserved_quantity")
  importedRequirement Decimal? @map("imported_requirement")
  importedAt          DateTime @map("imported_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("expected_requirements")
}

/// Règle de correspondance colonne → champ apprise à partir des corrections manuelles
/// de l'utilisateur (voir ADR 0003 et docs/architecture.md §3). Générique et sans aucune
/// connaissance métier : `source` (ex: "OPENSI", futurs "MAGENTO"/"CRM"/...) et `entityType`
/// (ex: "ARTICLES", "STOCKS"...) sont de simples chaînes définies par les configurations de
/// mapping de chaque module, pas des enums figés — un nouveau connecteur n'exige donc jamais
/// de migration de schéma. Une règle n'est mémorisée qu'au moment de la confirmation d'un
/// import (jamais à la seule prévisualisation), pour ne pas apprendre une correction abandonnée.
model ColumnMappingRule {
  id                   String   @id @default(uuid())
  siteId               String   @map("site_id")
  site                 Site     @relation(fields: [siteId], references: [id])
  source               String
  /// Version du format d'export de la source (ex: "2026.1"), pour qu'un changement de
  /// format côté connecteur (OpenSi, Magento...) n'entre jamais en conflit avec les règles
  /// apprises sur un format antérieur. Valeur par défaut appliquée par le service si non
  /// fournie (voir ColumnMappingService.DEFAULT_SOURCE_VERSION), jamais figée en base.
  sourceVersion        String   @map("source_version")
  entityType           String   @map("entity_type")
  columnNameNormalized String   @map("column_name_normalized")
  columnNameOriginal   String   @map("column_name_original")
  fieldKey             String   @map("field_key")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([siteId, source, sourceVersion, entityType, columnNameNormalized])
  @@map("column_mapping_rules")
}
