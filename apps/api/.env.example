# Copier ce fichier en ".env" puis ajuster les valeurs pour l'environnement local.

# Connexion à l'instance PostgreSQL locale.
# Créer au préalable le rôle et la base (exemple, à exécuter une fois via psql) :
#   CREATE ROLE lca_mes LOGIN PASSWORD 'changez-moi';
#   CREATE DATABASE lca_mes_dev OWNER lca_mes;
DATABASE_URL="postgresql://lca_mes:changez-moi@localhost:5432/lca_mes_dev?schema=public"

# Secret utilisé pour signer les JWT. Obligatoire, au moins 32 caractères, et
# différent entre développement et production — générer avec `openssl rand -hex 32`.
# La valeur ci-dessous est un exemple documentaire non fonctionnel : le démarrage
# échoue explicitement si elle (ou toute autre valeur manifestement faible/générique)
# est utilisée telle quelle.
JWT_SECRET="a-remplacer-par-une-valeur-forte-et-secrete"
# Durée de validité du token, en secondes (28800 = 8h)
JWT_EXPIRES_IN_SECONDS=28800

PORT=3000
NODE_ENV=development

# URL du webhook Make relié au système de retours (voir FeedbackWebhookService).
# Optionnelle : laisser vide si non utilisé, le système de retours fonctionne
# normalement sans elle. Ne jamais y renseigner de vraie URL dans un fichier commité.
MAKE_FEEDBACK_WEBHOOK_URL=

# Assistant IA (voir docs/roadmap.md) — sélecteur de fournisseur (AI-06,
# voir AssistantModule) : "echo" (défaut, aucun appel réseau réel, sûr en
# développement/tests) ou "openai" (fournisseur réel via le SDK officiel).
AI_PROVIDER=echo
# Obligatoire uniquement si AI_PROVIDER=openai — jamais de vraie clé dans un
# fichier commité (ceci est un exemple factice, non fonctionnel).
AI_API_KEY=sk-votre-cle-api-openai
# Passerelle personnalisée (optionnelle) : proxy d'entreprise ou passerelle
# self-hosted compatible OpenAI (ex: Ollama, vLLM, LiteLLM). https autorisé
# vers tout hôte ; http autorisé uniquement vers localhost/127.0.0.1.
AI_BASE_URL=
# Organisation/projet OpenAI (optionnels, sans effet pour AI_PROVIDER=echo).
AI_ORGANIZATION=
AI_PROJECT=
# Nom du modèle — obligatoire si AI_PROVIDER=openai (ex: gpt-4o-mini), jamais
# codé en dur dans l'orchestrateur. Défaut "stub-echo" si AI_PROVIDER=echo.
AI_MODEL=stub-echo
# Délai maximal (ms) accordé à une génération complète avant abandon explicite.
AI_REQUEST_TIMEOUT_MS=30000
# Limite de tokens de sortie transmise au fournisseur.
AI_MAX_OUTPUT_TOKENS=1024
# Tool calling (AI-04) — garde-fous contre une boucle de raisonnement infinie.
AI_MAX_TOOL_CALLS=10
AI_MAX_TOOL_CALL_TURNS=5
AI_MAX_TOOL_CALL_DEPTH=5
# Context Engine (AI-05) — budget du contexte envoyé au fournisseur.
AI_CONTEXT_MAX_TOKENS=8000
AI_CONTEXT_MAX_MESSAGES=40
AI_CONTEXT_MAX_MESSAGE_CHARS=4000
AI_CONTEXT_RECENT_MESSAGES_MIN=6
